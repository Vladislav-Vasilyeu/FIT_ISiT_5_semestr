<Window x:Class="COURSEPROJECT.PersonalAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:COURSEPROJECT"
        mc:Ignorable="d"    
        Title="{DynamicResource Personalaccount}" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">


    <Grid Style="{DynamicResource GridAuthorization}">
        <Border Style="{DynamicResource PersonalBorderStyle}">
            <StackPanel Style="{DynamicResource AuthorizationStackPanelStyle}">
                <TextBlock Style="{DynamicResource AuthorizationTextBlockStyle}" Text="{DynamicResource Personalaccount}"/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Login}"/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" x:Name="LoginText" Text=""/>
                <!--<TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Password}"/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" x:Name="PasswordText" Text=""/>-->
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Numberofcompletedorders}"/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" x:Name="CountOrdersActive" Text=""/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Totaltimeofcompletedorders}"/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" x:Name="allTime" Text=""/>
                <WrapPanel x:Name="itemsuser" Orientation="Vertical">
                    
                </WrapPanel>
                <Button x:Name="GetStat" Click="GenerateStatsAdmin" Content="{DynamicResource SystemStatistics}" Visibility="Collapsed" Style="{DynamicResource AuthorizationButtonStyleTrigger}"/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Changepassword}"/>
                <local:CustomPasswordBox VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Password"/>
                <Border Margin="0 10 0 0">
                    <Button Style="{DynamicResource AuthorizationButtonStyleTrigger}" Content="{DynamicResource Savechanges}" Command="{Binding SaveInfoCommand}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>