<Window x:Class="COURSEPROJECT.Item"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:COURSEPROJECT"
        
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{DynamicResource Computerbooking}" Height="500" Width="800">
    <Grid>
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="/images/pcphoto.png" Stretch="UniformToFill" Opacity="1"/>
            </Border.Background>
            <StackPanel Background="#7F000000">
                <TextBlock x:Name="computerid" Text="{Binding Id}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource PC}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Cpu}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Gpu}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ram" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Storage}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="monitor" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="rating" Text="" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="price" Text="" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <DatePicker Margin="0 7 0 0"  x:Name="selectedDate" Width="200"
                    materialDesign:HintAssist.Hint="{DynamicResource DatePickerHintText}"
                    SelectedDate="{Binding SelectedDate}">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="Text" Value="{DynamicResource DatePickerHintText}"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
                <StackPanel Margin="0 7 0 0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox Margin="0 0 5 0"
                        x:Name="starttime" 
                        Width="80" 
                        Text="00:00" 
                        materialDesign:HintAssist.Hint="Начальное время"
                        PreviewTextInput="NumericTextBox_PreviewTextInput" />
                    <TextBox Margin="5 0 0 0"
                        x:Name="endtime" 
                        Width="80" 
                        Text="23:59" 
                        materialDesign:HintAssist.Hint="Конечное время"
                        PreviewTextInput="NumericTextBox_PreviewTextInput" />
                </StackPanel>
                <TextBlock Margin="0 10 0 0" x:Name="costpc" Text="" Foreground="White" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                <Button Margin="0 7 0 0" Style="{DynamicResource AuthorizationButtonStyleTrigger}" Click="WriteInfoByItem" MaxWidth="100"  Content="{DynamicResource Toorder}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>