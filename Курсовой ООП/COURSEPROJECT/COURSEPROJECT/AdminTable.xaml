<Window x:Class="COURSEPROJECT.AdminTable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:COURSEPROJECT"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{DynamicResource Projectdatamanagement}" Height="720" Width="1280">
    <Grid Style="{DynamicResource GridAdminStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <ComboBox x:Name="TableBox" Width="200" SelectedIndex="1">
                <ComboBoxItem>Users</ComboBoxItem>
                <ComboBoxItem>Computers</ComboBoxItem>
                <ComboBoxItem>Orders</ComboBoxItem>
                <ComboBoxItem>Reviews</ComboBoxItem>
                <ComboBoxItem>ApplicationGame</ComboBoxItem>
            </ComboBox>
            <TextBox Width="100" x:Name="inputuser">
            </TextBox>
            <TextBox Width="100" x:Name="inputcomputer">
            </TextBox>
            <ComboBox x:Name="TableParam" Width="200">
                <ComboBoxItem x:Name="comp1" Content="{DynamicResource Powerfulprocessors}"></ComboBoxItem>
                <ComboBoxItem x:Name="comp2" Content="{DynamicResource Powerfulgraphicscards}"></ComboBoxItem>
                <ComboBoxItem x:Name="comp3" Content="{DynamicResource Expensive}"></ComboBoxItem>
                <ComboBoxItem x:Name="ord1" Content="{DynamicResource Completed}"></ComboBoxItem>
                <ComboBoxItem x:Name="ord2" Content="{DynamicResource Active}"></ComboBoxItem>
                <ComboBoxItem x:Name="ord3" Content="{DynamicResource Cancelled}"></ComboBoxItem>
            </ComboBox>
            <Button Grid.Row="0"
                Content="{DynamicResource Adding}" 
                Width="150" Height="30"/>
            <Button Grid.Row="0"
                Content="{DynamicResource Editing}" 
                Width="150" Height="30" Click="GetUpdateRows"/>
            <Button Grid.Row="0" 
                Content="{DynamicResource Deleting}"
                Width="150" Height="30" Click="DeleteRowButton_Click"/>
        </StackPanel>
        <DataGrid Style="{DynamicResource GridDataAdminStyle}"
            Grid.Row="1"
            x:Name="dataGrid" 
            AutoGenerateColumns="True"
            CanUserAddRows="True"
            CanUserDeleteRows="True"
            CanUserReorderColumns="True"
            IsReadOnly="False" 
            RowBackground="White"/>
    </Grid>
</Window>
