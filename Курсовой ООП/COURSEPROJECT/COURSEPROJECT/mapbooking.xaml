<Window x:Class="COURSEPROJECT.mapbooking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:COURSEPROJECT"
        mc:Ignorable="d"
        Title="{DynamicResource Seatreservations}" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Style="{DynamicResource GridStyle}">
        <Canvas x:Name="ClubMap" Width="800" Height="600" Style="{DynamicResource CanvasStyle}">
            <Rectangle Canvas.Left="50" Canvas.Top="50" Width="700" Height="500" 
               Stroke="White" StrokeThickness="3" Fill="Transparent"/>
        </Canvas>
    </Grid>
</Window>
