<Window x:Class="COURSEPROJECT.registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:COURSEPROJECT"
        mc:Ignorable="d"
        Title="{DynamicResource Registration}" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">


    <Grid Style="{DynamicResource GridAuthorization}">
        <Border Style="{DynamicResource AuthorizationBorderStyle}">
            <StackPanel Style="{DynamicResource AuthorizationStackPanelStyle}">
                <TextBlock Style="{DynamicResource AuthorizationTextBlockStyle}" Text="{DynamicResource Registration}"/>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Login}"/>
                <Border Style="{DynamicResource AuthorizationInputBorderStyle}">
                    <TextBox Style="{DynamicResource AuthorizationTextBoxStyle}" x:Name="Login"/>
                </Border>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Password}"/>
                <Border Style="{DynamicResource AuthorizationInputBorderStyle}">
                    <PasswordBox Style="{DynamicResource AuthorizationPasswordBoxStyle}" x:Name="Password1"/>
                </Border>
                <TextBlock Style="{DynamicResource AuthorizationLabelTextBlockStyle}" Text="{DynamicResource Repeatthepassword}"/>
                <Border Style="{DynamicResource AuthorizationInputBorderStyle}">
                    <PasswordBox Style="{DynamicResource AuthorizationPasswordBoxStyle}" x:Name="Password2"/>
                </Border>
                <Border>
                    <Button Style="{DynamicResource AuthorizationButtonStyleTrigger}" Content="{DynamicResource Registration}" Command="{Binding AddNewUserCommand}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>