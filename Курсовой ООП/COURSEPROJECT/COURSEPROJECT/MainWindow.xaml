<Window x:Class="COURSEPROJECT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:COURSEPROJECT"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Mainwindow}" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#3f3f3f">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Left" MinWidth="60" VerticalAlignment="Stretch" Background="#3f3f3f">
                <DockPanel LastChildFill="False" Margin="10">
                    <Image Width="60" Source="/images/translogo.png" DockPanel.Dock="Top" Margin="0 30 0 0"/>
                    <Button Style="{DynamicResource TransparentButtonStyle}" Command="{Binding OpenMapbookingCommand}" Background="Transparent" BorderThickness="0" DockPanel.Dock="Top">
                        <Image Width="60" Source="/images/time.png" Margin="0 15 0 0" x:Name="UserBooking" Visibility="Collapsed"/>
                    </Button>
                    <Button Style="{DynamicResource TransparentButtonStyle}" Command="{Binding OpenGamesCommand}" Background="Transparent" BorderThickness="0" DockPanel.Dock="Top">
                        <Image Width="60" Source="/images/game.png" DockPanel.Dock="Top" Margin="0 5 0 0"/>
                    </Button>
                    <Button Style="{DynamicResource TransparentButtonStyle}" Command="{Binding OpenAdminTableCommand}" Background="Transparent" BorderThickness="0" DockPanel.Dock="Top">
                        <Image Width="60" Source="/images/database_icon.png" Margin="0 5 0 0" x:Name="AdminDBTable" Visibility="Collapsed"/>
                    </Button>
                    <local:MusicValueElement DockPanel.Dock="Bottom" />
                    <TextBlock DockPanel.Dock="Bottom" Text="" Height="10"/> 
                    <local:RadiusButton DockPanel.Dock="Bottom" Padding="0 10 0 0" Click="SwitchMusicStatus" />
                </DockPanel>
            </Border>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Background>
                    <DynamicResource ResourceKey="mainfon"/>
                </Border.Background>
                <DockPanel LastChildFill="True">
                    <DockPanel LastChildFill="False" Width="auto" DockPanel.Dock="Top" MinHeight="80">
                        <Border Style="{DynamicResource RoundedBorderStyle}" Width="300" Height="50" Margin="30 0 0 0">
                            <TextBox x:Name="ResearchPCInformation" Style="{DynamicResource TextBoxDataTrigger}" MaxLength="20"/>
                        </Border>
                        <Button Style="{DynamicResource TransparentButtonStyle}" Command="{Binding ReseachPCCommand}" Background="Transparent" BorderThickness="0">
                            <Image Width="60" Source="/images/search2.png" Margin="10 0 0 0"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="10 0 0 0" Style="{DynamicResource UserStackPanelStyle}">
                            <Button Width="90" Content="{DynamicResource Russian}" Click="SwitchToRussian" Style="{DynamicResource AnimationLangBtn}" Template="{DynamicResource LangButtonTemplate}"/>
                            <Button Width="90" Content="{DynamicResource English}" Click="SwitchToEnglish" Style="{DynamicResource AnimationLangBtn}" Template="{DynamicResource LangButtonTemplate}"/>
                        </StackPanel>
                        <Button Width="140" Content="{DynamicResource ChangeTheme}" Command="{Binding ChangeThemeBtnCommand}" Style="{DynamicResource AnimationLangBtn}" Template="{DynamicResource ThemeButtonTemplate}"/>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource TransparentButtonStyle}" Background="Transparent" BorderThickness="0" Padding="0">
                            <Border  Margin="0 0 30 0" CornerRadius="10" MinWidth="200" Height="70" Style="{DynamicResource UserButtonStyle}">
                                <StackPanel Style="{DynamicResource UserStackPanelStyle}">
                                    <Button Style="{DynamicResource TransparentButtonStyle}" Command="{Binding OpenAuthorizationCommand}" Background="Transparent" BorderThickness="0">
                                        <Button.ToolTip>
                                            <ToolTip Style="{DynamicResource CustomToolTip}">
                                                <TextBlock Text="{DynamicResource Auth}"/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                        <Image Margin="10 0 0 0" Width="40" Source="/images/user.png"/>
                                    </Button>
                                    <Button Style="{DynamicResource TransparentButtonStyle}" Command="{Binding OpenPersonalCommand}" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                                        <TextBlock x:Name="UserName" Style="{DynamicResource UserNameTextBlockStyle}" Text="" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{DynamicResource TransparentButtonStyle}" Command="{Binding OpenPersonalCommand}" Background="Transparent" BorderThickness="0">
                                        <Button.ToolTip>
                                            <ToolTip x:Name="ToolPersonal" Style="{DynamicResource CustomToolTip}">
                                                <TextBlock Text="{DynamicResource Personalaccount}"/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                        <TextBlock x:Name="UserNameView" Style="{DynamicResource UserNameTextBlockStyle}" Text="{DynamicResource user}" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid DockPanel.Dock="Top" Margin="10 0 10 0" x:Name="ContainerPc">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>