<Window x:Class="COURSEPROJECT.WritingReview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:COURSEPROJECT"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        Title="{DynamicResource UserFeedback}" Height="450" Width="800">
    <Grid Style="{DynamicResource WritingReviewFon}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Arial Black" Text="{DynamicResource Makinganorderreview}"/>
                <TextBlock Margin="10 0 0 0"  FontFamily="Arial Black" Text="{Binding Id}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <TextBlock FontFamily="Arial Black" Text="{DynamicResource PC}"/>
                <TextBlock Margin="10 0 0 0" FontFamily="Arial Black" Text="{Binding ComputerId}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <TextBlock FontFamily="Arial Black" Text="{DynamicResource Payment}"/>
                <TextBlock Margin="10 0 0 0" FontFamily="Arial Black" x:Name="cost" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <TextBlock FontFamily="Arial Black" Text="{DynamicResource UserFeedback}"/>
                <TextBlock Margin="10 0 0 0" FontFamily="Arial Black" x:Name="username" Text=""/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <TextBox x:Name="textReview" 
                        Width="600" 
                        Height="200"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" MaxWidth="100" Margin="0 10 0 10">
                <Slider x:Name="stats" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>
            <Button Click="SaveReview" Content="{DynamicResource Send}" Width="90" Style="{DynamicResource AnimationLangBtn}" Template="{DynamicResource LangButtonTemplate}">
                
            </Button>
        </StackPanel>
    </Grid>
</Window>
